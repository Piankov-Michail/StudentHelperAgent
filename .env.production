# Production Environment Variables

# Database
POSTGRES_USER=student_helper
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=student_helper
DATABASE_URL=postgresql+asyncpg://student_helper:CHANGE_THIS_SECURE_PASSWORD@postgres:5432/student_helper

# Security
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_MIN_32_CHARS
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_STRING_32_CHARS

# Domain (для скриптов)
DOMAIN=your-domain.com
EMAIL=your-email@example.com
